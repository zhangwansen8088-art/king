# 复制为 .env 后再修改。JWT_SECRET 必须替换成随机长字符串。
NODE_ENV=development
PORT=3000
# 宿主机直接运行 API（pnpm dev）时使用；Docker Compose 部署不读这个变量。
WEB_ORIGIN=http://localhost:5173
# 生产必须显式改为 true，否则刷新 Cookie 不带 Secure 标记。
COOKIE_SECURE=false
DATABASE_URL=postgresql://max_promotion:max_promotion_dev@127.0.0.1:5432/max_promotion?schema=public
POSTGRES_DB=max_promotion
POSTGRES_USER=max_promotion
POSTGRES_PASSWORD=max_promotion_dev
JWT_SECRET=replace-with-at-least-32-random-characters
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=7
REFRESH_COOKIE_NAME=max_refresh
ENABLE_SWAGGER=true
SEED_DEMO_DATA=false
DEMO_ADMIN_USERNAME=admin
DEMO_ADMIN_PASSWORD=change-me-admin
DEMO_PROMOTER_USERNAME=promoter
DEMO_PROMOTER_PASSWORD=change-me-promoter

# 服务端 5xx 告警；留空即关闭。Webhook 接收 JSON，不包含业务数据和认证信息。
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_TIMEOUT_MS=5000
ALERT_COOLDOWN_MINUTES=15

# 审计日志自动清理默认关闭；启用时保留天数不得低于 30。
AUDIT_RETENTION_DAYS=0
AUDIT_CLEANUP_INTERVAL_HOURS=24
AUDIT_CLEANUP_BATCH_SIZE=1000

# 登录限速与可信代理。生产代理必须使用明确网段，禁止配置为信任所有来源。
LOGIN_MAX_FAILURES=5
LOGIN_WINDOW_MINUTES=15
LOGIN_LOCK_MINUTES=15
LOGIN_ATTEMPT_RETENTION_HOURS=24
TRUST_PROXY_CIDRS=loopback,linklocal,uniquelocal

# Docker Compose 访问信息
APP_PORT=8080
# Docker Compose 部署的唯一正式域名变量：它会注入容器内的 WEB_ORIGIN。
# 生产必须改成正式域名（含 https:// 与端口），否则登录、刷新、注销会被判 403。
COMPOSE_WEB_ORIGIN=http://localhost:8080
